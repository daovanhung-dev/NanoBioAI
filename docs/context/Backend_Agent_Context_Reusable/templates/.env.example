# Placeholder values only. Never commit real .env.
APP_ENV=local
APP_NAME=your-backend
API_PREFIX=/api/v1
ENABLE_DOCS=true
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+psycopg://app_user:CHANGE_ME@127.0.0.1:5432/app_db
# Choose auth mechanism/algorithm before setting keys. Store actual secrets outside Git.
JWT_ALGORITHM=ES256
JWT_ISSUER=your-backend
JWT_AUDIENCE=your-client
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private_key.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public_key.pem
REFRESH_TOKEN_PEPPER=CHANGE_ME_USE_RANDOM_SECRET_32PLUS_CHARS
# Optional components only when enabled
REDIS_URL=
EXTERNAL_API_TIMEOUT_SECONDS=5
