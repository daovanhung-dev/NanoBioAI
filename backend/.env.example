APP_ENV=development
APP_NAME=NanoBioAI Backend
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://nanobio@127.0.0.1:5432/nanobio
JWT_SECRET_KEY=
JWT_ISSUER=nanobio-backend
JWT_AUDIENCE=nanobio-clients
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
UPLOAD_ROOT=/var/lib/nanobio-backend/uploads
MAX_UPLOAD_BYTES=10485760
RATE_LIMIT_HMAC_KEY=
EARLY_ACCESS_PHONE_HMAC_KEY=
EARLY_ACCESS_APK_DOWNLOAD_URL=
MEMBERSHIP_PAYMENT_PRICES_JSON=
MEMBERSHIP_PAYMENT_BANK_JSON=
NIN_API_KEY=
USDA_API_KEY=
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
PUBLIC_API_BASE_URL=https://api.example.invalid
SLEEP_SAFETY_PROVIDER_BASE_URL=
SLEEP_SAFETY_PROVIDER_TOKEN=
SLEEP_SAFETY_PROVIDER_WEBHOOK_SECRET=
SLEEP_SAFETY_ENABLED=false
SLEEP_SAFETY_MAX_DISPATCHES_PER_HOUR=3
SLEEP_SAFETY_EVENT_FRESHNESS_SECONDS=600
SLEEP_SAFETY_VERIFICATION_TTL_SECONDS=600
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_CONNECT_TIMEOUT_SECONDS=3
OLLAMA_READ_TIMEOUT_SECONDS=120
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=96
OLLAMA_TECHNICAL_REQUESTS_PER_MINUTE=6
