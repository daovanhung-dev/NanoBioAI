APP_ENV=development
APP_NAME=NanoBioAI Backend
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://nanobio@127.0.0.1:5432/nanobio
JWT_SECRET_KEY=
JWT_ISSUER=nanobio-backend
JWT_AUDIENCE=nanobio-clients
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","https://daovanhung-dev.github.io"]
UPLOAD_ROOT=/var/lib/nanobio-backend/uploads
MAX_UPLOAD_BYTES=10485760
RATE_LIMIT_HMAC_KEY=
EARLY_ACCESS_PHONE_HMAC_KEY=
EARLY_ACCESS_APK_DOWNLOAD_URL=
MEMBERSHIP_PAYMENT_PRICES_JSON=
MEMBERSHIP_PAYMENT_BANK_JSON=
NIN_API_KEY=
USDA_API_KEY=
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:support@nanobioai.com
PUBLIC_API_BASE_URL=https://nanobio.s2w.click
SLEEP_SAFETY_PROVIDER_BASE_URL=
SLEEP_SAFETY_PROVIDER_TOKEN=
SLEEP_SAFETY_PROVIDER_WEBHOOK_SECRET=
SLEEP_SAFETY_ENABLED=false
SLEEP_SAFETY_MAX_DISPATCHES_PER_HOUR=3
SLEEP_SAFETY_EVENT_FRESHNESS_SECONDS=600
SLEEP_SAFETY_VERIFICATION_TTL_SECONDS=600
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_CONNECT_TIMEOUT_SECONDS=3
OLLAMA_READ_TIMEOUT_SECONDS=120
OLLAMA_TOTAL_TIMEOUT_SECONDS=120
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=1024
OLLAMA_TRUNCATION_RETRY_ENABLED=false
OLLAMA_TECHNICAL_REQUESTS_PER_MINUTE=30

# Nabi ESP voice service. Use a generated secret of at least 32 characters;
# share it only between nanobio-backend and nanobio-iot-speech-worker.
IOT_WEBSOCKET_URL=wss://nanobio.s2w.click/api/v1/iot/ws
IOT_SPEECH_WORKER_URL=http://127.0.0.1:8765
IOT_SPEECH_WORKER_TOKEN=
IOT_SNAPSHOT_MAX_AGE_DAYS=90
IOT_MODEL_CACHE=/var/lib/nanobio-iot/models
IOT_WHISPER_MODEL=small
IOT_PIPER_VOICE=/var/lib/nanobio-iot/models/vi_VN-vais1000-medium.onnx
